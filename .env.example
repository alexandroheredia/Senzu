# Senzu environment configuration.
#
# Copy this file to `.env` and fill in your values. `.env` is git-ignored;
# `.env.example` is committed as a template.

# Google AI Studio API key used by the nutrition-facts image reader.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Vision model used to read nutrition labels.
# Defaults to gemini-3-flash-preview (gemini-2.0-flash is retired for new keys).
GEMINI_MODEL=gemini-3-flash-preview
